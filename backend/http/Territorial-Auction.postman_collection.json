{
  "info": {
    "name": "Territorial Auction",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "회원가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password1!\",\n  \"nickname\": \"테스트유저\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "signup"]
            }
          }
        },
        {
          "name": "로그인",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const token = pm.response.json().data.accessToken;",
                  "pm.environment.set('accessToken', token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password1!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "AccessToken 갱신",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const token = pm.response.json().data.accessToken;",
                  "pm.environment.set('accessToken', token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "로그아웃",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set('accessToken', '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        },
        {
          "name": "유저네임 중복 확인",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/check-username?username=testuser",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "check-username"],
              "query": [
                {
                  "key": "username",
                  "value": "testuser"
                }
              ]
            }
          }
        },
        {
          "name": "이메일 중복 확인",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/check-email?email=test@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "check-email"],
              "query": [
                {
                  "key": "email",
                  "value": "test@example.com"
                }
              ]
            }
          }
        },
        {
          "name": "닉네임 중복 확인",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/check-nickname?nickname=테스트유저",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "check-nickname"],
              "query": [
                {
                  "key": "nickname",
                  "value": "테스트유저"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
