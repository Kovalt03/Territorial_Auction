        {
          "name": "로그아웃",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set('accessToken', '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
