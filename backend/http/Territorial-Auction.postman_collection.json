        {
          "name": "AccessToken 갱신",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const token = pm.response.json().data.accessToken;",
                  "pm.environment.set('accessToken', token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            }
          }
