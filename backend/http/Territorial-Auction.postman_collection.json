        {
          "name": "회원가입",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password1!\",\n  \"nickname\": \"테스트유저\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
