baseUrl = http://localhost:8080

# WebSocket/STOMP 테스트는 .http 파일로 지원되지 않습니다.
# 수동 테스트 방법:
#
#   const socket = new SockJS('/ws');
#   const client = Stomp.over(socket);
#   client.connect({ Authorization: `Bearer ${accessToken}` }, () => {
#       client.subscribe('/sub/chat/room_global', msg => console.log(JSON.parse(msg.body)));
#       client.send('/pub/chat/room_global', {}, JSON.stringify({ content: '안녕하세요!' }));
#   });

### [GLOBAL] 최신 메시지 30개 조회
GET {{baseUrl}}/api/v1/chat/rooms/room_global/messages
Authorization: Bearer {{accessToken}}

### [GLOBAL] 커서 페이징 — messageId 100 이전 메시지 30개
GET {{baseUrl}}/api/v1/chat/rooms/room_global/messages?before=100&size=30
Authorization: Bearer {{accessToken}}

### [GLOBAL] size 지정 — 최신 10개만 조회
GET {{baseUrl}}/api/v1/chat/rooms/room_global/messages?size=10
Authorization: Bearer {{accessToken}}

### [GUILD] 길드 채팅 히스토리 조회 (guildId=1)
GET {{baseUrl}}/api/v1/chat/rooms/room_guild_1/messages
Authorization: Bearer {{accessToken}}

### [GUILD] 커서 페이징 — messageId 50 이전 메시지 (guildId=1)
GET {{baseUrl}}/api/v1/chat/rooms/room_guild_1/messages?before=50&size=20
Authorization: Bearer {{accessToken}}

### [TERRITORY] 영토 채팅 히스토리 조회 (territoryId=7)
GET {{baseUrl}}/api/v1/chat/rooms/room_territory_7/messages
Authorization: Bearer {{accessToken}}

### 에러: 존재하지 않는 채팅방 (404 CHAT_ROOM_NOT_FOUND)
GET {{baseUrl}}/api/v1/chat/rooms/room_global/messages
Authorization: Bearer {{accessToken}}

### 에러: 잘못된 roomId 형식 (404 CHAT_ROOM_NOT_FOUND)
GET {{baseUrl}}/api/v1/chat/rooms/invalid_room_id/messages
Authorization: Bearer {{accessToken}}

### 에러: 인증 없이 조회 시도 (401)
GET {{baseUrl}}/api/v1/chat/rooms/room_global/messages
