JWT_SECRET=your-secret-key-here-must-be-at-least-32-characters
DB_NAME=territorial_auction
DB_USERNAME=postgres
DB_PASSWORD=change-this-for-each-environment

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# 관리자 페이지 (선택)
# ADMIN_IP_ALLOWLIST: 관리자 로그인 허용 IP(쉼표 구분). 비우면 전체 허용(개발)
ADMIN_IP_ALLOWLIST=
# 시드 관리자 계정 — email/password 모두 있으면 기동 시 자동 생성/승격 (운영은 비워둘 것)
ADMIN_SEED_EMAIL=your-admin-id
ADMIN_SEED_PASSWORD=your-admin-password
